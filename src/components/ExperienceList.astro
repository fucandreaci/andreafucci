---
import { experience } from "@data/experience";
---

<ul class="flex flex-col divide-y divide-white/10">
  {
    experience.map((entry, i) => (
      <li class="reveal py-4 first:pt-0 space-y-1" style={`--i: ${i}`}>
        <div class="font-medium text-white">{entry.company}</div>
        <div class="mono text-xs text-white/40">{entry.period}</div>
        <p class="text-sm">{entry.description}</p>
      </li>
    ))
  }
</ul>
